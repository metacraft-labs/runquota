# Cross-repo siblings cloned by setup-dev-env at workspace-lock-pinned
# revisions (see codetracer-specs/Testing/Cross-Repo-CI-Integration.md).

# The package catalog `repro.nim`'s `uses: "sqlite3"` resolves from. sqlite3
# is no longer bundled with reprobuild's stdlib; reprobuild looks it up in a
# `reprobuild-packages` checkout beside this one, and a recipe that uses a moved
# package with no catalog reachable does not compile. Only the reprobuild-flavor
# job compiles `repro.nim`; the nix jobs never do (their `sqlite3` tool is
# `pkgs.sqlite` in the dev shell).
#
# Pinned to an exact revision (reprobuild-packages 15ceea6, published on its
# `agents` branch; it declares the version of sqlite3's Windows archives, which
# `uses: "sqlite3 >=3"` needs) rather than `=dev`, which clone-siblings warns
# makes the build not reproducible. The
# catalog is also locked by the flake input used by the owning Nix shell.
# Keep this non-Nix CI pin aligned with that source constructor.
reprobuild-packages=15ceea674d3e83b8fd1a3032e4f01569c04a8fa5

# RunQuota's published stats table requires this source-library interface.
# Explicitly override the carried workspace pin until it includes the interface.
# These two siblings must be the revisions repro.lock records for them
# (`deps`): the repro engine refuses a checkout whose HEAD differs from the
# revision the consumer lock expects ("cross-repo producer ... source revision
# mismatch"). 22e3100 is the nim-shm-lease `agents` merge that contains the
# earlier 665e128 interface revision (identical tree); flake.lock agrees.
nim-shm-lease!=22e3100cdb4fbc374689ddac55b4b32c90654140
# Transitive source dependency of shm_lease/obsring, at the revision repro.lock
# and flake.lock record (84fd76b descends from the previously pinned 02f442a).
nim-shm-queue=84fd76b174d4868e703ba3d599668ee340e0b6ea
