.direnv/
result
result-*

build/
# The packaging payload, staged from `build/bin` by
# `scripts/stage_package_payload.sh`. It is a COPY of build output and
# must never be committed: a checked-in binary here would be what every
# package shipped, silently, regardless of what the tree compiles to.
packaging/prebuilt/
nimcache/
htmldocs/
*.nimble-link

test-logs/
repomix/
bench-results/

.DS_Store
.repro/
.pre-commit-config.yaml

# Agent tooling scratch. `claude --isolation worktree` materialises one git
# worktree per agent under this path, inside the repo. They are disposable and
# per-machine, and while an agent holds one the repo reads DIRTY — which
# `repro workspace lock` refuses, so an untracked one stops the whole
# workspace publishing locks, not just this repo.
.claude/worktrees/
